{
  "name": "yt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "setup:downloads": "node scripts/setup-downloader.mjs",
    "syllabus:extract": "node scripts/read-syllabus.mjs",
    "format": "prettier --write src server shared scripts tests public/sw.js vite.config.js playwright.config.js index.html",
    "coverage:syllabus": "node scripts/coverage-report.mjs",
    "videos:verify": "node scripts/build-topic-videos.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "pdfjs-dist": "^4.10.38",
    "prettier": "^3.6.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
