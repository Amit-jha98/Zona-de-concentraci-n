# Server-side key, never VITE_YOUTUBE_API_KEY. Node loads .env via npm scripts.
YOUTUBE_API_KEY=
# Optional absolute path if yt-dlp is already installed elsewhere.
YT_DLP_PATH=
# Optional absolute FFmpeg executable path when it is not on PATH.
FFMPEG_PATH=
# Vercel only: connect a PRIVATE Blob store in the project's Storage tab.
# Vercel configures BLOB_STORE_ID + OIDC, or BLOB_READ_WRITE_TOKEN, automatically.
# Never prefix storage credentials with VITE_.
BLOB_READ_WRITE_TOKEN=
# Random server-only secret (at least 32 characters) for daily cleanup.
CRON_SECRET=
# HOST=127.0.0.1
# PORT=4173
