{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/handler.js": {
      "maxDuration": 300,
      "supportsCancellation": true,
      "includeFiles": "{.tools/yt-dlp,node_modules/ffmpeg-static/ffmpeg}",
      "excludeFiles": "{docs/**,tests/**,.downloads/**,.tools/*.exe,public/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?__path=:path*" }
  ],
  "crons": [{ "path": "/api/maintenance/downloads", "schedule": "0 3 * * *" }]
}
