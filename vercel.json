{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/handler.js": {
      "maxDuration": 300,
      "supportsCancellation": true,
      "includeFiles": "{.tools/yt-dlp,node_modules/ffmpeg-static/ffmpeg,public/gate-pyq-bank.json,public/gate-exam-notes/*.json}",
      "excludeFiles": "{docs/**,tests/**,.downloads/**,.tools/*.exe,public/pyq/**,public/*.pdf}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?__path=:path*" }
  ],
  "crons": [{ "path": "/api/maintenance/downloads", "schedule": "0 3 * * *" }]
}
